# EventPilot AI - Environment Configuration
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys to version control.

# Supabase PostgreSQL & Auth Configuration
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini API Key (Required for Phase 4 AI Event Architect)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Supabase Service Role Key (Used strictly for server-side admin operations, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=
